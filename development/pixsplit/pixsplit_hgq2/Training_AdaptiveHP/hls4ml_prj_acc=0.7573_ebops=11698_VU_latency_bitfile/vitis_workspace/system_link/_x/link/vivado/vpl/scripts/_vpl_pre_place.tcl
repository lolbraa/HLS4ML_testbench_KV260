set xocc_optimize_level 0
set_property SEVERITY {Warning} [get_drc_checks HDPR-5]
set_param logicopt.enableBUFGinsertHFN 0

foreach cell [get_cells -hierarchical -filter {VITIS_REGION!=""}] {
  set candidate_pb_name [get_property VITIS_REGION ${cell}]
  set candidate_pb [get_pblocks -quiet ${candidate_pb_name}]
  if {[string length ${candidate_pb}] > 0} {
    add_cells_to_pblock ${candidate_pb} ${cell}
  }
}
