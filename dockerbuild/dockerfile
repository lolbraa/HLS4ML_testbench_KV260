# Entrypoint sources the Vivado/Vitis files and offers menu for configuring environment
COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT [ "/entrypoint.sh" ]

# Defaulting to bash (can be overridden to run jupyter, code-server, etc.)
#CMD ["/bin/bash", "-l"]

