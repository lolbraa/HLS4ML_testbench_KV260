# Environment for synthesizing Keras-models with Vitis Unified
name: devenv-vu
channels:
  - defaults
  - conda-forge
dependencies:
  - python=3.12
  - keras=3.13.2
  - tensorflow=2.18.*
  - scikit-learn=1.8.*
  - numpy=1.26.*
  - scipy=1.17.*
  - notebook=7.5.*
  - matplotlib=3.10.*
  - gradio=6.8.*
  - tensorflow-datasets=4.8.*
  - pip
  - pip:
      - "hls4ml[profiling] @ git+https://github.com/lolbraa/hls4ml-kv260.git@VitisUnifiedClean" # "hls4ml[profiling,optimization,sr,hgq,qkeras] @ file:///home/ncgadmin/Bachelor/hls4ml-kv260"
#      - "hls4ml[profiling,optimization,sr,hgq,qkeras] @ git+https://github.com/lolbraa/hls4ml-kv260.git@main"
#      - hls4ml[profiling,optimization,sr,hgq,qkeras]==1.2.0
      
