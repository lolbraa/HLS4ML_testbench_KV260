# Environment used to train QKeras models and baselines (minimal core packages)
name: devenv-training-qkeras
channels:
  - defaults
  - conda-forge
dependencies:
  - python=3.10.*
  - tensorflow=2.18.*
  - numpy=1.26.*
  - scipy=1.15.*
  - notebook=7.5.*
  - scikit-learn=1.7.*
  - matplotlib=3.10.*
  - tensorflow-datasets=4.9.*
  - pip
  - pip:
    - QKeras==0.9.0
    - tf_keras==2.18.0
    - tensorflow-model-optimization==0.8.0
    - keras-tuner==1.4.8
    - kt-legacy==1.0.5