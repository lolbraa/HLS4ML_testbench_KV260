name: devenv-standard
channels:
  - conda-forge
dependencies:
  - python
  - keras
  - tensorflow
  - scikit-learn
  - numpy
  - scipy
  - notebook
  - matplotlib
  - gradio
  - tensorflow-datasets
  - pip
  - pip:
      - hgq2
      - hls4ml[profiling,sr,hgq2] # ,optimization dependency conflicts
      
